#!/usr/bin/env python3
"""The `nexus-gh` entry point — the one name the Python capabilities answer to (story #297).

It self-locates: `resolve()` follows the symlink a package manager leaves on the caller's path
back to this file, so the toolkit root is found from the file's own position and never from the
working directory or from anything relative to a repository.

The interpreter is `python3` by shebang and by the manifest declaration that installs this file,
never a bare `python`.
"""

import sys
from pathlib import Path

# A pipeline stage must leave no trace in the repository it ran against (story #309). The
# interpreter would otherwise drop a `__pycache__` beside every module it imports — inside a
# source checkout that is the repository itself, and inside an installed package it is a
# directory the registry's own file manifest does not know how to remove.
sys.dont_write_bytecode = True

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from nexus_gh.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
